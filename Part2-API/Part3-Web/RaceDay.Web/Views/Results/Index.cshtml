@model List<MyResult>
@{
    ViewData["Title"] = "My results";
}
<div class="page-header">
    <h1 class="rd-heading">My results</h1>
    <p>Your race history.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">No results yet. Results appear here after the organiser publishes them.</div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EventName</td>
                        <td>@r.EventDate.ToString("d MMM yyyy")</td>
                        <td>@r.CategoryName</td>
                        <td class="fw-bold">@Fmt.Time(r.FinishTime)</td>
                        <td><span class="position">@Fmt.Ordinal(r.Position)</span> out of @r.TotalFinishers finishers</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
