@{
    var loggedIn = Context.Session.IsLoggedIn();
    var role = Context.Session.GetRole();
    var name = Context.Session.GetDisplayName();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (loggedIn && role == Roles.Organiser)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Manage" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Manage" asp-action="Events">My events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Manage" asp-action="Create">New event</a></li>
                    }
                    else if (loggedIn)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Enrolments" asp-action="Index">My enrolments</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Results" asp-action="Index">My results</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (loggedIn)
                    {
                        <li class="nav-item"><span class="navbar-text me-lg-2">Hi, @name <span class="role-tag">@role</span></span></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm ms-lg-2">Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-rd btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Sign up</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container rd-main">
        @if (TempData["Success"] is string okMessage)
        {
            <div class="alert alert-success rd-alert" role="alert">@okMessage</div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger rd-alert" role="alert">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">RACEDAY - run it, walk it, ride it.</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
