@model EventForm
@{
    var isEdit = ViewData["IsEdit"] is true;
}
<form method="post" action="@(isEdit ? Url.Action("Edit", new { id = Model.Id }) : Url.Action("Create"))" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="BannerImage" />
    @if (!isEdit)
    {
        <input type="hidden" asp-for="Status" />
    }

    <div class="row">
        <div class="col-md-8 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Date" class="form-label">Date and time</label>
            <input asp-for="Date" type="datetime-local" class="form-control" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Distance" class="form-label"></label>
            <input asp-for="Distance" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Capacity" class="form-label"></label>
            <input asp-for="Capacity" type="number" class="form-control" />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>
        @if (isEdit)
        {
            <div class="col-md-4 mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Scheduled">Scheduled</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="Banner" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.BannerImage))
        {
            <div class="mb-2"><img class="event-banner banner-preview" src="@Url.Action("Get", "Images", new { name = Model.BannerImage })" alt="Current banner" /></div>
        }
        <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
        <div class="form-text">JPG, PNG or WEBP, up to 5 MB. It is stored in Azure Blob Storage.</div>
    </div>

    <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
    <a class="btn btn-outline-dark" asp-action="Events">Cancel</a>
</form>
