@model List<MyEnrollment>
@{
    ViewData["Title"] = "My enrolments";
}
<div class="page-header">
    <h1 class="rd-heading">My enrolments</h1>
    <p>Every event you have signed up for.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">You have not enrolled for any events yet. <a asp-controller="Events" asp-action="Index">Find an event</a></div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th>Enrolled on</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                        <td>@e.EventDate.ToString("d MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td>@e.EnrollmentDate.ToString("d MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
